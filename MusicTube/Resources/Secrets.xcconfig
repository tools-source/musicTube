// Safe checked-in template. Never place production credentials in this file.
// Copy values into Secrets.local.xcconfig, which is ignored by git.
// Native Google OAuth uses PKCE and does not require a client secret.
YOUTUBE_API_KEY = YOUR_YOUTUBE_API_KEY
YOUTUBE_CLIENT_ID = YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
YOUTUBE_URL_SCHEME = com.googleusercontent.apps.YOUR_REVERSED_CLIENT_ID
YOUTUBE_REDIRECT_URI = $(YOUTUBE_URL_SCHEME):/oauth2redirect
MUSICTUBE_URL_SCHEME = musictube

// Optional developer-controlled AI curation proxy. Keep this empty to use
// MusicTube's deterministic on-device recommendation engine exclusively.
MUSICTUBE_AI_ENDPOINT = https:/$()/musictube-api-322459144075.us-east4.run.app/api/curate

#include? "Secrets.local.xcconfig"
